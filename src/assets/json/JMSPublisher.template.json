{
  "type": "jms-producer",
  "module": {
    "name": "module",
    "display": "Module",
    "element-type": "object",
    "elements": [
      {
        "import": "basic-jms-publisher"
      },
      {
        "import": "dependencies"
      },
      {
        "import": "dirspec"
      },
      {
        "name": "broker_property",
        "display": "Broker Property",
        "element-type": "object",
        "elements": [
          {
            "name": "broker_type",
            "display": "Broker Type",
            "element-type": "string",
            "input-type": "select",
            "default-val": "activemq"
          },
          {
            "name": "host",
            "display": "Host",
            "element-type": "string",
            "default-val": "active-mq-svc.lcnc-comp-ms-queue",
            "help-text": "Should be a valid IP address or DNS name",
            "validations": [{"required": true},{"pattern": true, "pattern-value": "([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]{0,61}[a-zA-Z0-9])(.([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]{0,61}[a-zA-Z0-9]))*"}]
          },
          {
            "name": "port",
            "display": "Port",
            "element-type": "string",
            "help-text": "Should be a valid port number, no more than 65535",
            "validations": [{"required": true},{"pattern": true, "pattern-value": "([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])"}]
          },
          {
            "name": "username",
            "display": "User Name",
            "element-type": "string",
            "default-val": "admin"
          },
          {
            "name": "password",
            "display": "Password",
            "element-type": "string",
            "default-val": "admin"
          }
        ]
      },
      {
        "import" : "resourcelist-jms-producer"
      }
    ]
  }
}
