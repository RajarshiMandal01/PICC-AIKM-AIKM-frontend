{
    "name": "dependencies",
    "display": "Dependencies",
    "element-type": "array",
    "elements": [
      {
        "name": "groupId",
        "display": "Group Id",
        "element-type": "string",
        "help-text": "For eg: org.modelmapper",
        "validations": [{"required": true},{"pattern": true, "pattern-value": "(?!.[.]{2})[a-z]+(?:[.][a-z]+)*" }]
      },
      {
        "name": "artifactId",
        "display": "Artifact Id",
        "element-type": "string",
        "help-text": "For eg: modelmapper",
        "validations": [{"required": true},{"pattern": true, "pattern-value": "(?!-[-]{2})[a-z]+(?:-[a-z]+)*" }]
      },
      {
        "name": "version",
        "display": "Version",
        "element-type": "string",
        "help-text": "For eg: 2.3.0",
        "validations": [{"required": true},{"pattern": true, "pattern-value": "(?![.])([0-9]+([.][0-9]+)*)([-.](SNAPSHOT))?(?![[0-9].])"}]
      },
      {
        "name": "scope",
        "display": "Scope",
        "element-type": "string",
        "help-text": "For eg: provided",
        "validations":  [{"required": true},{"pattern": true, "pattern-value": "[a-z]+"}]
      }
    ]
  }
