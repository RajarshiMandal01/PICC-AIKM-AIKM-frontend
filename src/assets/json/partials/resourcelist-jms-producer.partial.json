{
  "name": "resourcelist",
  "display": "Resource List",
  "element-type": "array",
  "elements": [
    {
      "name": "resources",
      "display": "Resources",
      "element-type": "string",
      "validations": [{"required": true},{"pattern": true, "pattern-value": "[a-z][a-zA-Z0-9]*" }],
      "help-text": "This is mandtory field. The first character must be an alphabet and should be lowercase"
    },
    {
      "name": "models",
      "display": "Models",
      "element-type": "array",
      "mandatory": true,
      "elements": [
        {
          "name": "name",
          "display": "Name",
          "element-type": "string",
          "help-text": "Mandatory field & has to start with capital letter",
          "validations": [{"required": true},{"pattern": true, "pattern-value": "[A-Z][a-zA-Z]*"}]
        },
        {
          "name": "model",
          "display": "Model",
          "element-type": "string",
          "input-type":"textarea",
          "editor": true,
          "editorMode": "json",
          "help-text": "This is a sample model structure, please modify as per your need.",
          "def-val": {"rootclass":"MyModelTO","schema":{"$schema":"http://json-schema.org/draft-04/schema#","type":"object","properties":{"id":{"type":"string"},"firstField":{"type":"string"},"secondField":{"type":"string"},"description":{"type":"string"}}}}

        }
      ]
    },
    {
      "name": "exceptions",
      "display": "Exceptions",
      "element-type": "array",
      "mandatory": true,
      "elements": [
        {
          "name": "name",
          "display": "Name",
          "element-type": "string",
          "help-text": "Mandatory field & has to start with capital letter",
          "validations": [{"required": true},{"pattern": true, "pattern-value": "[A-Z][a-zA-Z]*"}]

        },
        {
          "name": "extends",
          "display": "Extends",
          "element-type": "string",
          "default-val": "Exception",
          "read-only": true
        }
      ]
    },
    {
      "name": "queueconfig",
      "display": "Queue Config",
      "element-type": "object",
      "elements": [
        {
          "name": "broker_type",
          "display": "Broker Type",
          "element-type": "string",
          "input-type": "select",
          "default-val": "activemq"
        },
        {
          "name": "jms_template",
          "display": "Jms Template",
          "element-type": "object",
          "elements": [
            {
              "name": "delivery_mode",
              "display": "Delivery Mode",
              "element-type": "string",
              "input-type": "select",
              "default-val": "NON_PERSISTENT"
            },
            {
              "name": "pubsub",
              "display": "Pub Sub",
              "element-type": "string",
              "input-type":"select",
              "default-val": "false"
            }
          ]
        },{
          "name": "msg_converter",
          "display": "Message Converter",
          "element-type": "string",
          "default-val": "MappingJackson2MessageConverter",
          "read-only": true
        }
      ]
    },
    {
      "name": "services",
      "display": "Services",
      "element-type": "array",
      "elements": [
        {
          "name": "name",
          "display": "Name",
          "element-type": "string",
          "help-text": "Mandatory field & has to start with capital letter",
          "validations": [{"required": true},{"pattern": true, "pattern-value": "[A-Z][a-zA-Z]*"}]

        },
        {
          "name": "type",
          "display": "Type",
          "element-type": "string",
          "default-val": "provider"

        },
        {
          "name": "methodconfig",
          "display": "Method Config",
          "element-type": "array",
          "elements" :[
            {
              "name": "methodName",
              "display": "Method Name",
              "element-type": "string",
              "help-text": "Mandatory field & has to start with small letter",
              "validations": [{"required": true},{"pattern": true, "pattern-value": "[a-z][a-zA-Z]*" }]
            },
            {
              "name": "associatedQueue",
              "display": "Associated Queue",
              "element-type": "string",
              "help-text":"For eg: queue_1"

            },
            {
              "name": "Description",
              "display": "Description",
              "element-type": "string",
              "help-text":"For eg: post MyModel message to queue"

            },
            {
              "name": "requests",
              "display": "Requests",
              "element-type": "object",
              "elements":[
                {
                  "name": "type",
                  "display": "Type",
                  "element-type": "string",
                  "input-type": "select",
                  "help-text": "Mandatory field & has to start with capital letter. It is the datatype, for eg. String, Double, Float etc",
                  "validations": [{"required": true},{"pattern": true, "pattern-value": "[A-Z][a-zA-Z0-9]*" }]

                },
                {
                  "name": "var",
                  "display": "Var",
                  "element-type": "string",
                  "help-text": "Mandatory field & has to start with small letter",
                  "validations": [{"required": true},{"pattern": true, "pattern-value": "[a-z][a-zA-Z0-9]*" }]

                }
              ]
            },
            {
              "name": "response",
              "display": "Response",
              "element-type": "object",
              "elements":[
                {
                  "name": "type",
                  "display": "Type",
                  "element-type": "string",
                  "help-text": "For eg: void"

                }
              ]
            },
            {
              "name": "message_prop",
              "display": "Message Prop",
              "element-type": "array",
              "elements":[
                {
                  "name": "type",
                  "display": "Type",
                  "element-type": "string",
                  "input-type": "select",
                  "default-val": "String"
                },
                {
                  "name": "key",
                  "display": "Key",
                  "element-type": "string",
                  "help-text": "For eg: hkey1"
                },
                {
                  "name": "value",
                  "display": "Value",
                  "element-type": "string",
                  "help-text": "Has to be a valid value as per type selected",
                  "validations": [{"required": true}]

                }
              ]
            },
            {
                  "name": "message_priority",
                  "display": "Message Priority",
                  "element-type": "string",
                  "default-val": 1,
                  "help-text": "Mandatory field & has to be a number value",
                  "validations": [{"required": true},{"pattern": true, "pattern-value": "[0-9]+"}]

            },
            {
              "name": "exceptions",
              "display": "Exceptions",
              "element-type": "array",
              "mandatory": true,
              "elements":[
                {
                  "name":"code",
                  "display":"Message Code",
                  "element-type": "string",
                  "help-text": "For eg: 404"
                },
                {
                  "name":"expmesseage",
                  "display":"Exception Message",
                  "element-type": "string",
                  "help-text": "For eg: Not found"
                },
                {
                  "name":"expclass",
                  "display":"Exception Class",
                  "element-type": "string",
                  "input-type": "select",
                  "help-text": "For eg: MyModelNotFoundException"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "util",
      "display": "Util",
      "element-type": "array",
      "elements": [
        {
          "name":"name",
          "display":"Name",
          "element-type": "string",
          "help-text": "For eg: MyModelTOMapper"
        },
        {
          "name":"modelFirst",
          "display":"Model First",
          "element-type": "string",
          "input-type": "select"
        }
      ]
    }
  ]
}
